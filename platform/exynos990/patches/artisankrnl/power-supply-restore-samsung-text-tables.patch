 };
 
 static const char * const power_supply_technology_text[] = {
@@ -104,6 +168,11 @@ static const char * const power_supply_typec_src_rp_text[] = {
 	"Rp-Default", "Rp-1.5A", "Rp-3A"
 };
 
+/* Never index past a table or return a hole: report "Unknown" instead. */
+#define POWER_SUPPLY_TEXT(table, val)					\
+	(((unsigned int)(val) < ARRAY_SIZE(table) && (table)[(val)]) ?	\
+	 (table)[(val)] : "Unknown")
+
 static ssize_t power_supply_show_property(struct device *dev,
 					  struct device_attribute *attr,
 					  char *buf) {
@@ -132,25 +201,25 @@ static ssize_t power_supply_show_property(struct device *dev,
 
 	if (off == POWER_SUPPLY_PROP_STATUS)
 		return sprintf(buf, "%s\n",
-			       power_supply_status_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_status_text, value.intval));
 	else if (off == POWER_SUPPLY_PROP_CHARGE_TYPE)
 		return sprintf(buf, "%s\n",
-			       power_supply_charge_type_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_charge_type_text, value.intval));
 	else if (off == POWER_SUPPLY_PROP_HEALTH)
 		return sprintf(buf, "%s\n",
-			       power_supply_health_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_health_text, value.intval));
 	else if (off == POWER_SUPPLY_PROP_TECHNOLOGY)
 		return sprintf(buf, "%s\n",
-			       power_supply_technology_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_technology_text, value.intval));
 	else if (off == POWER_SUPPLY_PROP_CAPACITY_LEVEL)
 		return sprintf(buf, "%s\n",
-			       power_supply_capacity_level_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_capacity_level_text, value.intval));
 	else if (off == POWER_SUPPLY_PROP_TYPE)
 		return sprintf(buf, "%s\n",
-			       power_supply_type_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_type_text, value.intval));
 	else if (off == POWER_SUPPLY_PROP_SCOPE)
 		return sprintf(buf, "%s\n",
-			       power_supply_scope_text[value.intval]);
+			       POWER_SUPPLY_TEXT(power_supply_scope_text, value.intval));
 	else if (off >= POWER_SUPPLY_PROP_MODEL_NAME)
 		return sprintf(buf, "%s\n", value.strval);
 
